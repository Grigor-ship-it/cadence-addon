## pkgmeta for BigWigsMods/packager
package-as: Cadence
curse-id: 1535831
# Game versions are auto-detected by the packager from the TOC's
# `## Interface:` line (currently 120005, 120007). This avoids brittle
# hardcoded slug strings — packager queries CurseForge's live version
# list and tags the upload with whatever CF currently calls those builds.

ignore:
  - .github
  - .gitignore
  - sync-to-wow.ps1
  - LICENSE
  - THIRD_PARTY_LICENSES.md
  - README.md
